# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Node.js dependencies (rules-tests/ и любые другие npm-подпроекты).
# package.json/package-lock.json/исходники тестов остаются отслеживаемыми —
# разработчик сам прогоняет npm install после клонирования.
node_modules/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Локальные секреты (S3 access key/secret и т.п.) — не должны попадать в git.
# Сюда обычно кладут --dart-define значения для удобного запуска.
*.env
.env
.env.*
run_local.sh
run_local.ps1
run_local.bat
*.secrets
*secrets*.sh
*secrets*.ps1

# Android signing keystore (подпись release-сборки) — потеря/утечка = катастрофа,
# восстановить нельзя, обновления в Google Play станут невозможны.
*.keystore
*.jks
key.properties
keystore.properties
